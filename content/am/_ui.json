{
  "id": "ui",
  "version": 1,
  "strings": {
    "welcome": {
      "t": "እንኳን በደህና መጣሽ ወደ ቤታችን።",
      "audio": true
    },
    "welcome_sub": {
      "t": "ይህ መጽሐፍሽ ነው። የምትፈልጊው ሁሉ አለበት። በቋንቋሽ እና በድምፅ።",
      "audio": true
    },
    "start": {
      "t": "ጀምሪ"
    },
    "listen": {
      "t": "ስሚ"
    },
    "home": {
      "t": "መነሻ"
    },
    "book": {
      "t": "መጽሐፍ"
    },
    "book_sub": {
      "t": "ሁሉም ትምህርቶች"
    },
    "today": {
      "t": "ቀኔ"
    },
    "today_sub": {
      "t": "መርሀግብር እና ሥራዎች"
    },
    "replies": {
      "t": "መልሶቼ"
    },
    "replies_sub": {
      "t": "ጫኚ፣ የቤቱ ወይዘሮ በዓረብኛ ትሰማለች።"
    },
    "replies_hint": {
      "t": "ማንኛውንም ሐረግ ጫኚ፣ በዙሪያሽ ያሉ ሰዎች በዓረብኛ በታላቅ ድምፅ ይሰሙታል።",
      "audio": true
    },
    "emergency": {
      "t": "አስቸኳይ"
    },
    "emergency_sub": {
      "t": "ቁጥሮች እና ፈጣን እርምጃዎች"
    },
    "house_rules": {
      "t": "የቤታችን ደንቦች"
    },
    "house_rules_sub": {
      "t": "የቤቱ ወይዘሮ ለአንቺ መረጣቸው።"
    },
    "schedule": {
      "t": "የቀናችን መርሀግብር"
    },
    "rest_day": {
      "t": "የሳምንት እረፍት ቀንሽ"
    },
    "work_hours": {
      "t": "ዛሬ የሥራ ሰዓት"
    },
    "rest_hours": {
      "t": "እረፍትሽ ያልተቋረጠ"
    },
    "hours": {
      "t": "ሰዓት"
    },
    "copy_of": {
      "t": "የተለየ ቅጂ ለ"
    },
    "unlock_title": {
      "t": "የመጽሐፉን ኮድ አስገባ",
      "audio": true
    },
    "unlock_hint": {
      "t": "ኮዱ ከቤት ባለቤት ሴት ይገኛል. አንድ ጊዜ ብቻ ያስፈልግሻል.",
      "audio": true
    },
    "unlock_btn": {
      "t": "መጽሐፉን ክፈት"
    },
    "wrong_code": {
      "t": "ኮዱ ትክክል አይደለም. እንደገና ሞክሪ."
    },
    "install_title": {
      "t": "መጽሐፉን በስልክሽ ማያ ላይ አቁሚ",
      "audio": true
    },
    "ios_1": {
      "t": "ሊንኩን በሳፋሪ ክፈት.",
      "audio": true
    },
    "ios_2": {
      "t": "በማያው ታች ያለው የመካፈል አዝራር ጫኒ.",
      "audio": true
    },
    "ios_3": {
      "t": "አምሪ: ወደ መነሻ ማያ መጨመር፣ ከዚያ ጫኒ: መጨመር.",
      "audio": true
    },
    "and_1": {
      "t": "ሊንኩን በክሮም ክፈት.",
      "audio": true
    },
    "and_2": {
      "t": "በማያው ከላይ ያለውን ሶስት ነጥቦች ጫኒ.",
      "audio": true
    },
    "and_3": {
      "t": "አምሪ: ወደ መነሻ ማያ መጨመር፣ ወይም: መጫን.",
      "audio": true
    },
    "inapp_warn": {
      "t": "አንቺ በዋትስአፕ ውስጥ ነሽ. መጀመሪያ ሊንኩን በአሳሽ ክፈት.",
      "audio": true
    },
    "offline_ready": {
      "t": "መጽሐፉ አሁን ያለ ኢንተርኔት ይሰራል."
    },
